# Supabase → Project Settings → Database → Connection string
# Transaction pooler, порт 6543. Параметр pgbouncer нужен Prisma.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session, порт 5432. Эту строку Prisma использует для migrate.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Fastify. Сайт ходит сюда с localhost:3000.
PORT=3011
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# BotFather. Пока пусто, уведомления не отправляются, запись на сайте работает.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_URL="https://example.com/telegram/webhook"
TELEGRAM_WEBHOOK_SECRET=""
MINIAPP_URL=""
APP_URL="http://localhost:3000"

# Секрет, которым Supabase Cron вызывает Edge Function notifications.
CRON_SECRET=""

# Адреса API на проде.
API_PROXY_URL=
NEXT_PUBLIC_API_URL=
VITE_API_URL=


