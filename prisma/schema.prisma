generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show
}

enum BookingSource {
  web
  telegram
  admin
}

enum TimeOffType {
  vacation
  sick
  closed
  exception
}

model Barber {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  photoUrl        String  @map("photo_url")
  bio             String  @default("")
  experienceYears Int     @map("experience_years")
  telegramChatId  String? @map("telegram_chat_id")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  portfolio    PortfolioItem[]
  services     BarberService[]
  workingHours WorkingHour[]
  breaks       Break[]
  timeOff      TimeOff[]
  bookings     Booking[]
  reviews      Review[]
  links        BarberLink[]

  @@map("barbers")
}

model PortfolioItem {
  id        String @id @default(uuid()) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model BarberLink {
  code      String    @id
  barberId  String    @map("barber_id") @db.Uuid
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("barber_links")
}

model Service {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String
  durationMin Int     @map("duration_min")
  price       Int
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  barbers         BarberService[]
  bookingServices BookingService[]

  @@map("services")
}

model BarberService {
  barberId    String  @map("barber_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  durationMin Int?    @map("duration_min")
  price       Int?
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

/// weekday: 0 воскресенье ... 6 суббота, время в Asia/Tashkent.
model WorkingHour {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startTime])
  @@map("working_hours")
}

model Break {
  id        String   @id @default(uuid()) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startTime])
  @@map("breaks")
}

/// barber_id пустой: исключение на весь барбершоп.
model TimeOff {
  id       String      @id @default(uuid()) @db.Uuid
  barberId String?     @map("barber_id") @db.Uuid
  startsAt DateTime    @map("starts_at")
  endsAt   DateTime    @map("ends_at")
  type     TimeOffType
  note     String      @default("")

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("time_off")
}

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String
  telegramId     String?  @unique @map("telegram_id")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at")

  bookings Booking[]
  reviews  Review[]

  @@map("clients")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  barberId         String        @map("barber_id") @db.Uuid
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime      @map("ends_at")
  totalPrice       Int           @map("total_price")
  totalDurationMin Int           @map("total_duration_min")
  status           BookingStatus @default(confirmed)
  source           BookingSource
  manageToken      String        @unique @map("manage_token")
  createdAt        DateTime      @default(now()) @map("created_at")

  reminderDaySentAt  DateTime? @map("reminder_day_sent_at")
  reminder30mSentAt  DateTime? @map("reminder_30m_sent_at")
  reviewRequestedAt  DateTime? @map("review_requested_at")
  autoCompletedAt    DateTime? @map("auto_completed_at")

  /// Пишет триггер bookings_set_time_range. GENERATED сервер отклоняет: tstzrange() не immutable.
  timeRange Unsupported("tstzrange")? @map("time_range")

  client   Client           @relation(fields: [clientId], references: [id])
  barber   Barber           @relation(fields: [barberId], references: [id])
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt])
  @@index([status])
  @@map("bookings")
}

model BookingService {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @map("booking_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid
  name        String
  durationMin Int    @map("duration_min")
  price       Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  rating    Int
  comment   String   @default("")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@map("reviews")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model AdminUser {
  id             String         @id @default(uuid()) @db.Uuid
  login          String         @unique
  passwordHash   String         @map("password_hash")
  telegramChatId String?        @map("telegram_chat_id")
  sessions       AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  adminId   String   @map("admin_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}
